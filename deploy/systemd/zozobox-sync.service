# Zozo box cloud sync (docs/SYNC.md): drains the upload outbox to the
# Cloudflare worker, pushes config, imports grandma's messages. The only
# process that opens the store with recover_outbox=True.
[Unit]
Description=Zozo box cloud sync
Documentation=file:///opt/zozobox/src/docs/SYNC.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/zozobox
StartLimitIntervalSec=0

[Service]
Type=simple
User=zozobox
Group=zozobox
EnvironmentFile=/etc/zozobox/secrets.env
Environment=ZOZOBOX_DATA_DIR=/var/lib/zozobox
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/zozobox
ExecStart=/opt/zozobox/venv/bin/python -m zozobox.sync run
Restart=always
# Exit 1 = missing ZOZOBOX_CLOUD_URL / ZOZOBOX_BOX_TOKEN: don't spin.
RestartSec=30
TimeoutStopSec=40
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zozobox-sync
UMask=0007

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/zozobox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
