# Recognize mood takes recorded while offline (SPEC 2.1, PLAN M7).
[Unit]
Description=Zozo box offline mood recognition
Documentation=file:///opt/zozobox/src/docs/ENGINE.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/zozobox

[Service]
Type=oneshot
User=zozobox
Group=zozobox
EnvironmentFile=/etc/zozobox/secrets.env
Environment=ZOZOBOX_DATA_DIR=/var/lib/zozobox
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/zozobox
ExecStart=/opt/zozobox/venv/bin/python -m zozobox.mood reprocess
# 2 = stopped early (still offline / spend cap); takes stay pending. Not a failure.
SuccessExitStatus=2
TimeoutStartSec=30min
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zozobox-mood
UMask=0007

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/zozobox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
