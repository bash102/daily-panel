# Zozo box parent dashboard (FastAPI, SPEC 8). Reprints go through the same
# cross-process printer lock as the engine (<data dir>/.printer.lock).
[Unit]
Description=Zozo box parent dashboard
Documentation=file:///opt/zozobox/src/docs/DEPLOY.md
After=network.target time-sync.target
RequiresMountsFor=/var/lib/zozobox
StartLimitIntervalSec=0

[Service]
Type=simple
User=zozobox
Group=zozobox
SupplementaryGroups=lp plugdev
EnvironmentFile=/etc/zozobox/secrets.env
Environment=ZOZOBOX_DATA_DIR=/var/lib/zozobox
# [printer] and [app].printer_* for reprints: the same file as the engine.
Environment=ZOZOBOX_CONFIG=/etc/zozobox/box.toml
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/zozobox
# Reachable on the home LAN and over Tailscale; password required (SPEC 8).
# Before the first password exists, /setup needs the one-time token in
# /var/lib/zozobox/dashboard-setup-token (also logged to the journal).
ExecStart=/opt/zozobox/venv/bin/python -m zozobox.dashboard --printer brother --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
# Exit 2 = bad box.toml or the store cannot be opened: stay failed, don't spin.
RestartPreventExitStatus=2
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zozobox-dashboard
UMask=0007

# Hardening (keeps /dev: the dashboard prints on the USB QL-800).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/zozobox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
